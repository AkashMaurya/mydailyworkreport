# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FERNET_KEY=
DATABASE_PATH=instance/worklog.db

# OpenRouter (cloud AI) — works with any OpenAI-compatible endpoint.
# Leave OPENROUTER_BASE_URL empty to use the official https://openrouter.ai/api/v1
# or set a proxy URL like https://router.bynara.id/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=

# AI Provider — set to 'ollama' to use local LLM (no rate limits, no API key)
AI_PROVIDER=ollama

# Ollama (local AI — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
