# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
FERNET_KEY=

# Database — SQLite (default, local dev/tests)
DATABASE_PATH=instance/worklog.db

# Database — PostgreSQL/Neon (Render production).
# Postgres is used ONLY when DB_BACKEND=postgres AND DATABASE_URL are both set.
# On Render set these as dashboard environment variables (there is no .env there).
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Optional first-manager bootstrap (only used on an EMPTY users table)
# MANAGER_NAME=Your Name
# MANAGER_EMAIL=you@example.com
# MANAGER_PASSWORD=change-me

# Seed extras (never set in production): demo members + sample entries
# SEED_SAMPLE_DATA=1

# OpenRouter (cloud AI) — works with any OpenAI-compatible endpoint.
# Leave OPENROUTER_BASE_URL empty to use the official https://openrouter.ai/api/v1
# or set a proxy URL like https://router.bynara.id/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=

# AI Provider — set to 'ollama' to use local LLM (no rate limits, no API key)
AI_PROVIDER=ollama

# Ollama (local AI — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
