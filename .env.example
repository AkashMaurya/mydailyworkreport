# Flask
FLASK_SECRET_KEY=change-me-to-a-random-64-char-string
# Used for encrypting OpenRouter API key at rest (must be 32 url-safe base64 chars)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here-44chars-base64==
# OpenRouter (optional - can also be set via Manager Settings UI, stored encrypted in DB)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Database path (optional)
DATABASE_PATH=instance/worklog.db
